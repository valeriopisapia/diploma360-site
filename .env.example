# Diploma360 — variabili d'ambiente per il form lead → Brevo
# Copia questo file in `.env.local` (gitignored) e compila i valori per lo sviluppo locale.
# In produzione (Firebase App Hosting) questi valori arrivano dai secret di Cloud Secret Manager
# (vedi apphosting.yaml), NON da questo file.

# Chiave API v3 di Brevo (SEGRETA — mai committare). Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# ID numerico della lista Brevo dove entrano i lead. Brevo → Contatti → Liste.
BREVO_LIST_ID=

# Brand attivo (selezionato a BUILD-time). Opzionale: se assente, default `diploma360`.
# Valori validi: diploma360 | lascuola360. In produzione arriva dal secret `BRAND`
# mappato su questa env in apphosting.yaml.
NEXT_PUBLIC_BRAND=

# reCAPTCHA Enterprise sul form lead (opzionale). Chiave sito PUBBLICA, letta a BUILD:
# vuota → funzione disattivata (comportamento identico a prima). In locale i token non
# vengono verificati senza il metadata server di Cloud Run → fail-open con log.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Progetto GCP della chiave (server). Vuoto → nessuna verifica server.
RECAPTCHA_PROJECT_ID=
# "true" = rifiuta token mancanti/non validi/punteggio basso; default "false" = solo log.
RECAPTCHA_ENFORCE=false
# Punteggio minimo (0..1), default 0.3.
RECAPTCHA_SCORE_THRESHOLD=

# Rate limit best-effort per IP su /api/lead: richieste ogni 10 minuti (default 15, 0 = off).
LEAD_RATE_LIMIT_MAX=
# Origin aggiuntive ammesse su /api/lead (separate da virgola), oltre a domini brand,
# backend *.hosted.app di schoolrcloud, localhost e same-origin.
LEAD_ALLOWED_ORIGINS=
